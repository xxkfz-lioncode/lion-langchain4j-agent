<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 与 langchain4j-spring 1.20.0-beta30 配套的 Spring Boot 版本 -->
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>com.lion</groupId>
    <artifactId>lion-langchain4j-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lion-langchain4j-agent</name>
    <description>Lion LangChain4j Agent 后端：Spring Boot 3 + MyBatis-Plus + Sa-Token + Redisson + LangChain4j(千问)</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <sa-token.version>1.46.0</sa-token.version>
        <redisson.version>3.38.1</redisson.version>
        <!-- langchain4j 1.x: 核心 langchain4j:1.20.0 为稳定版, 官方 Spring Boot Starter
             采用配套的 beta 版本线(X.Y.0-betaZ, 与核心 X.Y.0 同日发布, 供生产使用),
             故此处取 1.20.0-beta30(与 langchain4j:1.20.0 配套) -->
        <langchain4j.version>1.20.0-beta30</langchain4j.version>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus (Spring Boot 3) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Sa-Token 鉴权 (Spring Boot 3) -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- Sa-Token 整合 Redisson: 登录态持久化到 Redis, 后端重启不再失效 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redisson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!-- Spring Security Crypto: 仅用 BCrypt 密码哈希, 不引入完整 security 过滤器链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Redisson (分布式锁 / 缓存客户端, 由 RedissonConfig 手动装配) -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- LangChain4j 核心 Starter + OpenAI 兼容协议 Starter(用于千问 DashScope)。
             langchain4j-spring-boot-starter 传递引入核心 langchain4j:1.20.0;
             langchain4j-open-ai-spring-boot-starter 为社区 OpenAI 兼容实现(可配 base-url 指向 DashScope),
             其内部依赖 langchain4j-open-ai:1.20.0 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- ==================== RAG 知识库(官方高层组件, 详见 RagService) ====================
             链路: 文档加载(FileSystemDocumentLoader + PDF 解析器) → 切分(DocumentSplitters)
             → 分批向量化入库 → EmbeddingStoreContentRetriever 相似度检索。
             向量化模型: DashScope text-embedding-v3(application.yml embedding-model);
             向量库: MilvusEmbeddingStore(milvus starter 自动装配), 需 Milvus 2.4+ 服务端。
        =================================================================================== -->
        <!-- 本地向量化模型: all-MiniLM-L6-v2(ONNX, 384 维, 模型内置在 jar 中, 离线可用)。
             当前 RAG 实际使用 DashScope text-embedding-v3(1024 维, 见 application.yml 的
             langchain4j.open-ai.embedding-model), 该依赖暂无代码引用, 先注释保留备选。
             若启用: 需提供 AllMiniLmL6V2EmbeddingModel Bean, 并把 langchain4j.milvus.dimension
             改为 384 后重建 collection(维度不一致会插入失败), 历史向量需重新导入。
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        -->
        <!-- PDF 文档解析器: 供 FileSystemDocumentLoader.loadDocument(路径, ApachePdfBoxDocumentParser) 使用 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-pdfbox</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <!-- Milvus 向量库: 由 MilvusEmbeddingStoreAutoConfiguration 自动装配
             MilvusEmbeddingStore(实现 EmbeddingStore<TextSegment>), 配置前缀 langchain4j.milvus -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-tika</artifactId>
            <version>1.0.0-beta4</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 在线接口文档: OpenAPI 3 + Swagger UI(支持在线调用; 2.8.x 官方兼容 Spring Boot 3.5) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.35</version>
        </dependency>
        <!-- Resilience4j 熔断器：防止外部服务故障级联拖垮整个应用 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-core</artifactId>
            <version>2.4.0</version>
        </dependency>
        <!-- 与 Spring Boot 3.5 配套的 starter; spring-boot4 版面向 Spring Boot 4 / Spring Framework 7, 本项目不适用 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.4.0</version>
        </dependency>
        <!-- 注解式熔断(@CircuitBreaker)基于 Spring AOP 切面, 必须引入 AOP Starter(aspectjweaver),
             否则注解会静默失效(不报错, 但完全不生效) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- 推荐：用于监控和查看容错组件状态 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Skills: 把 markdown "技能说明文档"当工具源, 让 LLM 按需读取作为上下文; 与 MCP 一起注册到 ManualAssistant -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-skills</artifactId>
            <version>1.20.0-beta30</version>
        </dependency>
        <!-- MCP: 让 LLM 调用外部工具(HTTP / stdio 两种传输, McpClientConfig 二选一), 通过 ManualAssistant 暴露给模型 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
            <version>1.20.0-beta30</version>
        </dependency>

        <!-- Guardrails: LLM 调用前后的输入/输出校验(示例见 LoggingInputGuardrail / LoggingOutputGuardrail) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-guardrails</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
