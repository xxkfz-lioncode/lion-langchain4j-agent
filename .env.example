# ============================================================
# Lion LangChain4j Agent 环境变量(示例)
# 用法: 复制本文件为 .env 并填写真实值, .env 已被 .gitignore 忽略
# 注意: 所有敏感信息只允许放在 .env 中, 严禁写入 application.yml
# ============================================================

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lion_agent
DB_USERNAME=root
DB_PASSWORD=你的数据库密码

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- 千问 / DashScope (阿里云百炼控制台申请) ----
# DashScope API Key, 形如: sk-xxxxxxxxxxxxxxxx
QWEN_API_KEY=sk-请替换为你自己的DashScope密钥
# OpenAI 兼容模式地址(一般无需修改)
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选: qwen-plus / qwen-max / qwen-turbo / deepseek-v3 等
QWEN_MODEL_NAME=qwen-plus

# ---- 服务 ----
SERVER_PORT=8080
